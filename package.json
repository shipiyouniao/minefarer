{
  "name": "minefarer",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A Minesweeper adventure, built as a TypeScript 7 native compiler experiment.",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "compile": "node scripts/compile.mjs",
    "build": "npm run compile && vite build",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "check": "npm run format:check && npm run check:pages && npm run check:contracts && npm run check:i18n && npm run typecheck && npm test && npm run build",
    "check:pages": "node scripts/test-pages-boundary.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "bench:types": "node scripts/bench-types.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:legacy": "node scripts/test.mjs --legacy",
    "build:legacy": "node scripts/build-variant.mjs legacy",
    "build:native": "node scripts/build-variant.mjs native",
    "bench:build": "node scripts/bench-build.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "typescript-legacy": "npm:typescript@6.0.3",
    "vite": "^8.2.2"
  }
}
